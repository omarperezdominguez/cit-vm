[Unit]
Description=API de Edge Mobility para RuTi (HTTPS :8443)
After=network-online.target mosquitto.service cit-ingesta.service
Wants=network-online.target
# MediaMTX le pregunta por cada acceso: sin API no hay video
Before=mediamtx.service

[Service]
User=citvm
Group=citvm
# API_TOKEN y MQTT_API
EnvironmentFile=/etc/cit-vm/secretos.env
EnvironmentFile=/etc/cit-vm/api.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/cit-vm
ExecStart=/usr/bin/python3 /opt/cit-vm/api.py
Restart=always
RestartSec=2
StateDirectory=cit-vm
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
